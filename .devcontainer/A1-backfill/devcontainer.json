{
  "name": "Labo A1 · backfill et rejeu avec Airflow",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "workspaceFolder": "/workspaces/labs-data-engineering/labs/A1-backfill",
  "containerEnv": {
    "AIRFLOW_HOME": "/workspaces/labs-data-engineering/labs/A1-backfill/airflow_home",
    "AIRFLOW__CORE__DAGS_FOLDER": "/workspaces/labs-data-engineering/labs/A1-backfill/dags",
    "AIRFLOW__CORE__LOAD_EXAMPLES": "False",
    "AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS": "True",
    "AIRFLOW__API__WORKERS": "1",
    "PYTHONPATH": "/workspaces/labs-data-engineering/labs/A1-backfill"
  },
  "postCreateCommand": "bash setup.sh",
  "postStartCommand": "bash demarrer_airflow.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Airflow", "onAutoForward": "openBrowser" }
  },
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] },
    "codespaces": { "openFiles": ["README.md", "dags/a1_dag.py", "lab/chargement.py"] }
  }
}
